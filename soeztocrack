                    if type(ignoreList) == 'table' and ignoreList[2] then
                        setnamecallmethod(method)

                        return origNamecall(obj, Ray.new(Vector3.new(0, 0, 0), Vector3.new(0, 0, 0)), select(2, ...))
                    end
                end
            end

            return origNamecall(obj, ...)
        end))
