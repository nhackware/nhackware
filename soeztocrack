        end

        hooked = true
        origNamecall = hookmetamethod(game, '__namecall', wrap(function(obj, ...)
            local method = getnamecallmethod()

            if method == 'FireServer' then
                if _G['Menu']['WaterGodmode'] and obj.Name == 'DamageHumanoid' then
