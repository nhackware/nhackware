    _G.BuyBatch = function(arg, want, storeFilter)
        local menu = _G['Menu']
        local RS = game:GetService('RunService')
        local rep = game:GetService('ReplicatedStorage')
        local drag = rep.Interaction.ClientIsDragging
        local invoke = rep.NPCDialog.PlayerChatted

        local function stopped()
            return menu['AutoBuyStop'] == true
        end

        local items, npc, counter, mismatch
        local waitStart = tick()
        local noted = false

        while true do
            if stopped() then
                return 0, 'stop'
            end
            items, npc, counter, mismatch = _G.FindAllItems(arg, storeFilter)
            if #items > 0 then
                break
            end
            if mismatch then
                _G['Notify'](tostring(arg) .. ' is not sold at ' .. tostring(storeFilter) .. ' - pick the item again')
                return 0, 'store'
            end
            if not noted then
                noted = true
                _G['Notify']('Wait for the item to refresh')
            end
            if tick() - waitStart > 45 then
                return 0, 'stock'
            end
            task.wait(0.1)
        end

        if not npc or not counter then
            _G['Notify']('Store for ' .. tostring(arg) .. ' not found')
            return 0, 'store'
        end

        local storeName = _G['CheckShop'](items[1]) or '?'
        if not npc.Verified and _G['FixedShopID'][storeName] == npc.ID then
            npc.Verified = true
        end

        local limit = math.min(want, math.min(tonumber(_G.MaxBatch) or 3, 3))
        local n = math.min(limit, #items)
        local unit = tonumber(_G['ItemPrice'](arg, 1)) or 0
        local money = 0
        pcall(function() money = _G['Self'].leaderstats.Money.Value end)

        if unit > 0 then
            local afford = math.floor(money / unit)
            if afford < 1 then
                _G['Notify'](string.format('Not enough money for %s ($%d each, you have $%d)', tostring(arg), math.floor(unit), math.floor(money)))
                return 0, 'money'
            end
            n = math.min(n, afford)
        end
        if not npc.Verified then
            n = 1
        end
        n = math.max(1, math.floor(n))

        if #items < limit then
            _G['Notify'](string.format('Only %d x %s in stock right now', #items, tostring(arg)))
        end

        local batch = {}
        for i = 1, n do
            batch[i] = items[i]
        end

        local function partOf(it)
            local p = it.PrimaryPart
            if not p then
                p = it:FindFirstChild('Main') or it:FindFirstChildOfClass('MeshPart') or it:FindFirstChildOfClass('Part')
                if p then
                    pcall(function() it.PrimaryPart = p end)
                end
            end
            return p
        end

        local counterPart = nil
        pcall(function() counterPart = game.Workspace.Stores[storeName].Counter end)
        local topY = counter.Position.Y
        local halfX, halfZ = 1.5, 1.5
        if counterPart then
            topY = counterPart.Position.Y + counterPart.Size.Y / 2
            halfX = math.min(math.max(counterPart.Size.X / 2 - 0.3, 0.5), 3)
            halfZ = math.min(math.max(counterPart.Size.Z / 2 - 0.3, 0.5), 3)
        end

        local ex, ez, eh = 0, 0, 0
        for _, it in ipairs(batch) do
            pcall(function()
                local _, s = it:GetBoundingBox()
                ex = math.max(ex, s.X)
                ez = math.max(ez, s.Z)
                eh = math.max(eh, s.Y)
            end)
        end
        ex = (ex > 0 and ex or 2) + 0.2
        ez = (ez > 0 and ez or 2) + 0.2
        eh = eh > 0 and eh or 2

        local cols = math.max(1, math.floor(halfX * 2 / ex))
        local rows = math.max(1, math.floor(halfZ * 2 / ez))
        local perLayer = cols * rows
        local lift = 0

        local function put(it, i)
            local p = partOf(it)
            if not p then return end
            pcall(function()
                local k = i - 1
                local layer = math.floor(k / perLayer)
                local idx = k % perLayer
                local layerCount = math.min(perLayer, n - layer * perLayer)
                local usedCols = math.min(cols, layerCount)
                local usedRows = math.ceil(layerCount / cols)
                local ox = ((idx % cols) - (usedCols - 1) / 2) * ex
                local oz = (math.floor(idx / cols) - (usedRows - 1) / 2) * ez
                local bbCF, bbSize = it:GetBoundingBox()
                local base = CFrame.new(counter.Position.X, topY, counter.Position.Z) * counter.Rotation
                local center = base * CFrame.new(ox, bbSize.Y / 2 + 0.5 + lift + layer * (eh + 0.3), oz)
                local rel = bbCF:ToObjectSpace(it:GetPivot())
                drag:FireServer(it)
                p.AssemblyLinearVelocity = Vector3.zero
                p.AssemblyAngularVelocity = Vector3.zero
                it:PivotTo(center * rel)
            end)
        end

        local function isBought(it)
            local ok, res = pcall(function()
                if it.Owner.Value ~= _G['Self'] then
                    return false
                end
                return (not it:FindFirstChild('BoxItemName')) or it:IsDescendantOf(game.Workspace.PlayerModels)
            end)
            return ok and res == true
        end

        local function distToMe(pos)
            local ok, d = pcall(function() return (_G['SelfOfPart'].Position - pos).Magnitude end)
            return ok and d or math.huge
        end

        local function endChat()
            task.spawn(function()
                pcall(function() invoke:InvokeServer(npc, 'EndChat') end)
            end)
        end

        for i, it in ipairs(batch) do
            if stopped() then
                return 0, 'stop'
            end
            local p = partOf(it)
            if p then
                if i == 1 or distToMe(p.Position) > 25 then
                    pcall(function() _G['Teleport'](p.CFrame - Vector3.new(1, -3, 1)) end)
                end
                for _ = 1, 2 do
                    put(it, i)
                    RS.Heartbeat:Wait()
                end
            end
        end

        pcall(function() _G['Teleport'](counter + Vector3.new(5, 0, 5)) end)

        for _ = 1, 4 do
            for i, it in ipairs(batch) do
                put(it, i)
            end
            RS.Heartbeat:Wait()
        end

        if not npc.Verified and unit > 0 then
            _G['Notify']('Finding ' .. tostring(npc.Name) .. ' ID...')
            local found = _G['DetectShopID'](npc, unit * n)
            if found then
                npc.ID = found
                npc.Verified = true
                _G['SaveShopID'](storeName, found)
            end
        end

        local noteKey = tostring(arg) .. '@' .. storeName
        if _G['LastPurchasePrompt'] ~= noteKey then
            _G['LastPurchasePrompt'] = noteKey
            _G['Notify']('Buying ' .. tostring(arg) .. ' at ' .. storeName .. ' (' .. tostring(npc.Name) .. ' #' .. tostring(npc.ID) .. ')')
        end

        local invoking, lastInvoke = false, 0
        local function confirm()
            if invoking and tick() - lastInvoke < 1.5 then
                return
            end
            invoking = true
            lastInvoke = tick()
            task.spawn(function()
                pcall(function() invoke:InvokeServer(npc, 'Initiate') end)
                pcall(function() invoke:InvokeServer(npc, 'ConfirmPurchase') end)
                invoking = false
            end)
        end

        local arrived = {}
        local arrivalConn = game.Workspace.PlayerModels.ChildAdded:Connect(function(child)
            task.spawn(function()
                local ov = child:WaitForChild('Owner', 5)
                if ov and ov.Value == _G['Self'] then
                    arrived[child] = true
                end
            end)
        end)

        local function validArrivals()
            local list = {}
            for child in pairs(arrived) do
                local pv = child:FindFirstChild('PurchasedBoxItemName')
                if child.Parent == game.Workspace.PlayerModels and pv and pv.Value == arg then
                    list[#list + 1] = child
                end
            end
            return list
        end

        local function boughtCount()
            local c = 0
            for _, it in ipairs(batch) do
                if isBought(it) then
                    c = c + 1
                end
            end
            return math.max(c, #validArrivals())
        end

        local reason = nil
        local lastCount = 0
        local lastProgress = tick()
        local lastCheck = tick()

        while true do
            if stopped() then
                reason = 'stop'
                break
            end

            confirm()
            RS.Heartbeat:Wait()

            local count = boughtCount()

            if count >= n then
                break
            end
            if count > lastCount then
                lastCount = count
                lastProgress = tick()
            end

            if tick() - lastCheck > 0.5 then
                lastCheck = tick()
                if tick() - lastProgress > 3 and lift == 0 then
                    lift = 1
                    for i, it in ipairs(batch) do
                        if not isBought(it) then
                            put(it, i)
                        end
                    end
                end
                for i, it in ipairs(batch) do
                    if not isBought(it) then
                        local p = partOf(it)
                        if p and (p.Position - counter.Position).Magnitude > 8 then
                            put(it, i)
                        end
                    end
                end
                if distToMe(counter.Position) > 25 then
                    pcall(function() _G['Teleport'](counter + Vector3.new(5, 0, 5)) end)
                end
            end

            if tick() - lastProgress > 10 then
                local m = 0
                pcall(function() m = _G['Self'].leaderstats.Money.Value end)
                _G['Notify'](string.format('%s not bought | store %s (%s #%s) | $%d', tostring(arg), storeName, tostring(npc.Name), tostring(npc.ID), math.floor(m)))
                _G['ForgetShopID'](storeName)
                reason = 'fail'
                break
            end
        end

        if reason == 'fail' then
            task.wait(1)
        end

        local base = menu['AutoBuyLocation']
        if not base then
            pcall(function() base = _G['SelfOfPart'].CFrame end)
        end
        local startIdx = _G['Amount'] or 0
        local carried = {}
        local carriedCount = 0

        local function carryNew()
            if not base then
                return 0
            end

            local pending = {}
            local function consider(it)
                if carried[it] or not it.Parent then
                    return
                end
                carried[it] = true
                carriedCount = carriedCount + 1
                local i = carriedCount
                local dest
                if menu['AutoBuyAnchor'] then
                    local k = (startIdx + i - 1) % 24
                    dest = base * CFrame.new(math.floor(k / 6) * 3, 1 + (k % 6) * 1.5, 0)
                else
                    dest = base * CFrame.new(((i - 1) % 4) * 1.5, 0, math.floor((i - 1) / 4) * 1.5)
                end
                pending[#pending + 1] = { item = it, dest = dest }
            end

            for _, it in ipairs(batch) do
                if isBought(it) then
                    consider(it)
                end
            end
            for _, it in ipairs(validArrivals()) do
                consider(it)
            end

            local total = #pending
            if total == 0 then
                return 0
            end

            for _ = 1, 3 do
                for _ = 1, (tonumber(_G.CarryFrames) or 15) do
                    for _, e in ipairs(pending) do
                        pcall(function()
                            drag:FireServer(e.item)
                            e.item:PivotTo(e.dest)
                        end)
                    end
                    RS.Stepped:Wait()
                end

                task.wait(0.1)

                local again = {}
                for _, e in ipairs(pending) do
                    local ok, d = pcall(function()
                        return (e.item:GetPivot().Position - e.dest.Position).Magnitude
                    end)
                    if e.item.Parent and (not ok or d > 8) then
                        again[#again + 1] = e
                    end
                end
                if #again == 0 then
                    break
                end
                pending = again
            end

            return total
        end

        local total = carryNew()
        total = total + carryNew()
        pcall(function() arrivalConn:Disconnect() end)

        if total > 0 and _G['AlreadyConfirmedShopID'][storeName] ~= npc.ID then
            npc.Verified = true
            _G['SaveShopID'](storeName, npc.ID)
        end

        endChat()

        return total, reason
    end

    _G['AutoBuyv2'] = function(arg1, arg2, flag, storeFilter, resume)
        local menu = _G['Menu']
        local prog = _G.BuyProgress

        if resume and prog and prog.item == arg1 then
            menu['AutoBuyLocation'] = prog.dest
            menu['AutoBuyAnchor'] = prog.anchor
        else
            local origin = nil
            pcall(function() origin = _G['SelfOfPart'].CFrame end)
            prog = {
                item = arg1,
                target = flag and math.huge or math.max(1, math.floor(tonumber(arg2) or 1)),
                bought = 0,
                store = storeFilter,
                dest = menu['AutoBuyLocation'],
                anchor = menu['AutoBuyAnchor'],
                origin = origin,
            }
            _G.BuyProgress = prog
        end

        prog.resumable = false
        _G['Amount'] = prog.bought
        _G['LastPurchasePrompt'] = nil

        local function tgtText()
            return prog.target == math.huge and 'inf' or tostring(prog.target)
        end
        local function show()
            pcall(function()
                _G['Self'].PlayerGui.MoneyDisplayGui.Text.Text = 'Autobuying:' .. prog.bought .. '/' .. tgtText()
            end)
            pcall(function()
                _G.BuyProgressLabel.Text = string.format('Progress: %d/%s %s', prog.bought, tgtText(), tostring(prog.item))
            end)
        end
        show()

        local reason = nil
        local loopOk, loopErr = pcall(function()
            while prog.bought < prog.target do
                if menu['AutoBuyStop'] == true then
                    reason = 'stop'
                    break
                end

                local got, why = _G.BuyBatch(arg1, prog.target - prog.bought, prog.store)
                prog.bought = prog.bought + got
                _G['Amount'] = prog.bought
                show()

                if why then
                    reason = why
                    break
                end
                if got == 0 then
                    reason = 'fail'
                    break
                end
            end
        end)
        if not loopOk then
            reason = 'error'
            _G['Notify']('Buy error: ' .. tostring(loopErr))
        end

        pcall(function()
            _G['Self'].PlayerGui.MoneyDisplayGui.Text.Text = tostring(_G['Self'].leaderstats.Money.Value)
        end)

        if reason == nil then
            if prog.target > 1 then
                _G['Notify'](string.format('Done: bought %d x %s', prog.bought, tostring(arg1)))
            end
        else
            local why = ({
                stop = 'Stopped',
                money = 'Not enough money',
                stock = 'Item did not restock in time',
                fail = 'Purchase timed out',
                store = 'Store problem',
                error = 'Error',
            })[reason] or reason

