        local invoke = game.ReplicatedStorage.NPCDialog.PlayerChatted
        local started = tick()

        for _, id in ipairs(order) do
            if _G['Menu']['AutoBuyStop'] == true or tick() - started > 40 then
                return nil
            end

            local probe = { ID = id, Character = info.Character, Name = info.Name, Dialog = info.Dialog }
            local done, res = false, nil

            task.spawn(function()
                local ok, r = pcall(function()
                    return invoke:InvokeServer(probe, 'Initiate')
                end)
                if ok then
                    res = r
                end
                done = true
                pcall(function()
                    invoke:InvokeServer(probe, 'EndChat')
                end)
            end)

            local t0 = tick()
            repeat
                task.wait()
            until done or tick() - t0 > 2

            if res ~= nil and _G['ContainsPrice'](res, total, {}, 0) then
                return id
            end
        end

        return nil
    end
